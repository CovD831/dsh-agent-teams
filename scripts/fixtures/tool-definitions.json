                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "skipped": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "kind": {
            "type": "string"
          },
          "runtime_gates": {},
          "status": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "subject",
          "status",
          "kind"
        ],
        "type": "object"
      }
    },
    "execute": "[function:wrapped/0]"
