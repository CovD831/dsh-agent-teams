  "agent_teams_send_message": {
    "kind": null,
    "description": "Send coordination or current-task guidance directly to the captain or a teammate. A running recipient receives it at the next model step; an idle recipient wakes. Messages are durably retained until read. Use task creation/reassignment for a new unit of work, not repeated status nudges.",
    "parameters": {
      "properties": {
        "content": {
          "description": "The message text.",
          "type": "string"
        },
        "from": {
          "description": "Sender (defaults to the caller: the captain, or the calling member).",
          "type": "string"
        },
        "source_attempt_id": {
          "description": "Sender execution capability paired with source_task_id. Stale reports are rejected. Omit for ordinary captain guidance.",
          "type": "string"
        },
        "source_task_id": {
          "description": "Sender task, NOT the recipient task. Members include it with source_attempt_id. Captains sending guidance normally omit both source fields.",
          "type": "string"
        },
        "to": {
          "description": "Recipient: \"captain\" or a member name.",
          "type": "string"
        }
      },
      "required": [
        "to",
        "content"
      ],
      "type": "object"
    },
    "output": {
      "render": "[function:render/2]",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "delivered": {
            "description": "live (accepted by the live captain), wake (member recipient woken), mailbox (durable inbox only), or duplicate (same message already retained).",
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "message_id": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        },
        "required": [
          "message_id",
          "from",
          "to",
          "delivered"
        ],
        "type": "object"
      }
    },
    "execute": "[function:execute/2]"
  },
