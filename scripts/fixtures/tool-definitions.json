        "role": {
          "description": "Role of the member (e.g. researcher, engineer, reviewer).",
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "output": {
      "render": "[function:render/2]",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "member_id": {
            "type": "string"
          },
          "member_name": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "phase": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "reasoning_effort": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        },
        "required": [
          "member_name",
          "member_id",
          "provider",
          "model",
          "status",
          "phase"
        ],
        "type": "object"
      }
    },
    "execute": "[function:execute/2]"
  },
  "agent_teams_amend_task": {
    "kind": null,
    "description": "Captain-only controlled contract amendment for one non-terminal quality task: replace a wrong objective/acceptance/verify/inScope/outOfScope when the original contract makes honest completion impossible (for example a verify command that cannot pass, or an inScope that forbids the file the objective names). The amendment is appended to the task's revisions ledger with previous values and the reason, and is rejected once a review/requirements task has passed judgment on this task. Members cannot amend contracts; the implementer re-reads the amended contract before its next quality gate. Lists are full replacements, not deltas.",
    "parameters": {
      "properties": {
        "acceptance": {
          "description": "Replacement acceptance criteria (full list, not a delta).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "inScope": {
          "description": "Replacement workspace-relative inScope paths (full list).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "description": "Replacement objective.",
          "type": "string"
        },
        "outOfScope": {
          "description": "Replacement workspace-relative outOfScope paths (full list).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "description": "Why the current contract is wrong; recorded in the revisions ledger.",
          "type": "string"
        },
        "task_id": {
          "description": "Task whose contract is being amended.",
          "type": "string"
        },
        "verify": {
          "description": "Replacement verification commands (full list, not a delta).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "task_id",
        "reason"
      ],
      "type": "object"
    },
    "output": {
      "render": "[function:render/2]",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "contract": {
            "type": "string"
          },
          "input_surface": {
            "additionalProperties": false,
            "properties": {
              "checked": {
                "type": "number"
              },
              "incomplete": {
                "type": "number"
              },
              "missing": {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "skipped": {
                "type": "number"
              }
            },
            "type": "object"
          },
          "revised_fields": {
            "type": "string"
          },
          "revision_count": {
            "type": "number"
          },
          "status": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "status",
          "revised_fields",
          "revision_count",
          "contract"
        ],
        "type": "object"
      }
    },
    "execute": "[function:wrapped/0]"
  },
