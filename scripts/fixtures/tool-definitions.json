  "agent_teams_create_task": {
    "kind": null,
    "description": "Create a task in your team's task list. Use kind=work (default) for research, repository audits and general tasks. kind=review is only a quality gate for an existing implementation/repair task via reviewedTaskId. Every call must include a non-empty subject, including verification and review tasks. Tasks can depend on other tasks (dependencies): a task is only claimable once every dependency is completed. Optionally assign it to a member, who still claims it before working.",
    "parameters": {
      "properties": {
        "acceptance": {
          "description": "Acceptance criteria. Required for quality kinds.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "assignee": {
          "description": "Member name when an owner is specified. Omission puts this task in the shared pool; roles, subjects and descriptions do not assign an owner.",
          "type": "string"
        },
        "coverageOf": {
          "description": "User-constraint / goal items this task covers.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "deliverables": {
          "description": "Expected deliverable paths or names.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dependencies": {
          "description": "Task ids this task depends on (must be completed before this task can be claimed).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "description": {
          "description": "What needs to be done, in detail.",
          "type": "string"
        },
        "inScope": {
          "description": "Workspace-relative POSIX paths this task may change.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "kind": {
          "description": "Explicit task kind. Omission means work with no quality gates, even if the subject says implementation/review. Quality kinds require a contract. An implementation may be planned before requirements passes when its dependency chain includes that requirements task.",
          "enum": [
            "work",
            "requirements",
            "implementation",
            "verification",
            "review",
            "repair",
            "integration"
          ],
          "type": "string"
        },
        "nonGoals": {
          "description": "Explicit non-goals.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "description": "Required non-empty objective for quality kinds.",
          "type": "string"
        },
        "outOfScope": {
          "description": "Workspace-relative POSIX paths this task must not change.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resume": {
          "description": "If true, clear halted in the same lock before creating the task.",
          "type": "boolean"
        },
        "resumeReason": {
          "description": "Required non-empty reason when resume=true.",
          "type": "string"
        },
        "reviewedTaskId": {
          "description": "Existing AgentTeams implementation/repair task id. Required for kind=review; an external repository audit is kind=work.",
          "type": "string"
        },
        "round": {
          "description": "1-based review / requirements / repair round.",
          "type": "number"
        },
        "sourceFindingIds": {
          "description": "Finding ids this repair must close.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "sourceTaskId": {
          "description": "Source implementation/artifact. Required for kind=repair.",
          "type": "string"
        },
        "subject": {
          "description": "Required non-empty title for this task. Never omit it, including for verification or review tasks.",
          "type": "string"
        },
        "verify": {
          "description": "Verification commands. Required for implementation/repair.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "subject"
      ],
      "type": "object"
    },
    "output": {
      "render": "[function:render/2]",
      "schema": {
        "additionalProperties": false,
        "properties": {
          "assignee": {
            "type": "string"
          },
          "input_surface": {
