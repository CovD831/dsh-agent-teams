  "agent_teams_edit_plan": {
    "kind": null,
    "description": "Atomically revise an AgentTeams plan. While staged, edit tasks and roster without starting work. While running, only update_task is allowed, and only for pending tasks with no prior attempt: correct dependencies, assignees or descriptions before they start; newly ready work is scheduled after commit. Never edit active/finished attempts. Submit dependent edits in order. Never modify .agent-teams files directly.",
    "parameters": {
      "properties": {
        "operations": {
          "description": "One atomic, ordered batch. Running teams allow only update_task for never-started pending tasks. If any operation is invalid, none of the edits are saved.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "action": {
                "enum": [
                  "update_member",
                  "update_task",
                  "add_task",
                  "remove_task",
                  "remove_member"
                ],
                "type": "string"
              },
              "assignee": {
                "description": "Optional task assignee; an empty string moves it to the shared pool.",
                "type": "string"
              },
              "dependencies": {
                "description": "Complete replacement dependency list for a task.",
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              "description": {
                "description": "Optional task description.",
                "type": "string"
              },
              "execution_prompt": {
                "description": "Optional member-specific execution prompt.",
                "type": "string"
              },
              "member_name": {
                "description": "Member name for update_member or remove_member.",
                "type": "string"
              },
              "model": {
                "description": "Optional member model; defaults to the current staged route.",
                "type": "string"
              },
              "provider": {
                "description": "Optional member provider; defaults to the current staged route.",
                "type": "string"
              },
              "reasoning_effort": {
                "description": "Optional member reasoning effort.",
                "type": "string"
              },
              "role": {
                "description": "Optional member role.",
                "type": "string"
              },
              "subject": {
                "description": "Required for add_task; optional replacement for update_task.",
                "type": "string"
              },
              "task_id": {
                "description": "Task id for update_task or remove_task.",
                "type": "string"
              }
            },
            "required": [
              "action"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "operations"
      ],
      "type": "object"
    },
    "output": {
